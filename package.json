{
  "private": true,
  "lint-staged": {
    "*.{ts,js,vue}": [
      "pnpm format",
      "pnpm lint:fix"
    ],
    "*.md": [
      "pnpm format",
      "pnpm mdlint:fix"
    ]
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write ./**/*.{ts,js,vue}",
    "format:check": "prettier --check ./**/*.{ts,js,vue}",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "mdlint": "markdownlint-cli2 ./content/**/*.md '#node_modules' '#.nuxt'",
    "mdlint:fix": "markdownlint-cli2 --fix ./content/**/*.md '#node_modules' '#.nuxt'",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/fa": "^1.2.2",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/ph": "^1.2.2",
    "@nuxt-themes/typography": "^1.0.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "^2.2.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/color": "^4.2.1",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.6.2",
    "baseline-browser-mapping": "^2.11.34",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint": "^0.42.0",
    "markdownlint-cli2": "^0.24.0",
    "nuxt": "^4.6.3",
    "nuxt-gtag": "^5.0.0",
    "nuxt-schema-org": "^7.0.1",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "shiki": "^4.5.0",
    "sitemap": "^10.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@nuxt/content": "3.16.2",
    "@nuxt/scripts": "^1.3.12",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "color": "^5.0.3",
    "daisyui": "^5.7.50",
    "node-html-parser": "^9.0.6",
    "pinia": "^4.1.0",
    "remark-breaks": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-jtf-style": "^3.0.3"
  },
  "packageManager": "pnpm@10.12.1",
  "volta": {
    "node": "24.22.1"
  }
}
